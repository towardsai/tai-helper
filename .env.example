# Public domains where the helper widget is allowed to run.
HELPER_ALLOWED_ORIGINS=https://towardsai.com,https://www.towardsai.com,https://academy.towardsai.net,https://towardsai.net,https://www.towardsai.net
HELPER_ALLOWED_HOSTS=towardsai.com,www.towardsai.com,academy.towardsai.net,towardsai.net,www.towardsai.net

# These public hosts allow the widget on every path except private/admin routes.
HELPER_SITE_WIDE_HOSTS=towardsai.com,www.towardsai.com

# Primary model: DeepSeek V4 Flash through OpenRouter. The direct DeepSeek API
# path was removed deliberately: that standalone account ran out of balance and
# took the helper down. HELPER_PRIMARY_MODEL can name any OpenRouter model.
HELPER_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
HELPER_PRIMARY_API_KEY=
HELPER_PRIMARY_MODEL=deepseek/deepseek-v4-flash
# OpenRouter serves one model id from many independent hosts at different
# quantisations, and they are NOT interchangeable for extractive grounding.
# Unpinned routing sent every request to one host that answered 0/6 on the
# main starter prompt. Preference order, first entry wins; fallbacks stay on.
HELPER_OPENROUTER_PROVIDER_ORDER=novita

# Backup model: Gemini 3.7 Flash, on Google's API rather than OpenRouter so the
# fallback does not share a gateway with the primary.
GEMINI_API_KEY=
HELPER_FALLBACK_MODEL=gemini-3.7-flash

# Reasoning is billed against HELPER_MAX_OUTPUT_TOKENS on both providers. Leave
# these off unless you also raise that budget, or the model spends it reasoning
# and returns a truncated answer that fails grounding validation.
HELPER_PRIMARY_REASONING=false
HELPER_GEMINI_THINKING_BUDGET=0
HELPER_MAX_OUTPUT_TOKENS=420
HELPER_LLM_REQUEST_TIMEOUT_SECONDS=20

# Hard public rate limits.
HELPER_RATE_LIMIT_PER_MINUTE=3
HELPER_RATE_LIMIT_PER_DAY=20
HELPER_GLOBAL_RATE_LIMIT_PER_MINUTE=120

# Request caps.
HELPER_MAX_BODY_BYTES=65536
HELPER_MAX_QUERY_CHARS=600
HELPER_MAX_HISTORY_TURNS=8

# Fail closed when the local public-page catalog has not been refreshed recently.
HELPER_CATALOG_MAX_AGE_DAYS=14

# Optional Opik monitoring.
OPIK_ENABLED=false
OPIK_PROJECT_NAME=towards-ai-helper
OPIK_WORKSPACE=
OPIK_API_KEY=
OPIK_MAX_TEXT_CHARS=4000
